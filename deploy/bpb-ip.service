[Unit]
Description=BPB Proxy IP scanner and Cloudflare DNS updater
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bpb-ip
ExecStart=/opt/bpb-ip/bpb-ip --config /opt/bpb-ip/config.json --list /opt/bpb-ip/list.txt --results-dir /opt/bpb-ip/results
StandardOutput=append:/var/log/bpb-ip.log
StandardError=inherit
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bpb-ip/archive.txt /opt/bpb-ip/results /var/log/bpb-ip.log

[Install]
WantedBy=multi-user.target
